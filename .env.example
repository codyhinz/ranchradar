# Copy to .env.local and fill in what you need. Every value is optional:
# a feature turns itself off when its variable is missing (no Supabase = guest-only build).
# Restart `npm run dev` after editing. For deploys, set these in
# Cloudflare → Worker → Settings → Builds → Variables.

# Accounts and sync — Supabase → Project Settings → Data API / API Keys
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Crash reports — Sentry project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# Bot check on email sign-in — Cloudflare → Turnstile → widget site key
# (needed once CAPTCHA is on in Supabase; add localhost to the widget's hostnames)
VITE_TURNSTILE_SITE_KEY=

# Ads — AdSense publisher id with ca- in front; slot only after approval
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=

# Push reminders — public key from `npm run vapid` (same as the VAPID_PUBLIC_KEY Supabase secret)
VITE_VAPID_PUBLIC_KEY=
